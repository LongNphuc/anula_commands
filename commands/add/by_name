#!/bin/sh

# $1: project name

by_name() {
    grep < "$ANULA_STORE/store_projects" -v '^#' | while read -r line; do
        project_name=$(echo "$line" | cut -f 1)
        project_repository=$(echo "$line" | cut -f 2)

        [ "$project_name" != "$1" ] && continue
        [ -d "$ANULA_PROJECTS/$project_name" ] && return "$("$ANULA_LIB/print_error" "project $1 already exists.")"

        git -C "$ANULA_PROJECTS" clone "$project_repository" "$project_name" && return
    done
}

by_name "$@"
